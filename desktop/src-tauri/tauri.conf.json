{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocuMind",
  "version": "0.1.2",
  "identifier": "com.documind.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/out"
  },
  "app": {
    "windows": [
      {
        "title": "DocuMind",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Gestion documentaire locale avec OCR et IA",
    "longDescription": "Client PC DocuMind : connexion à votre serveur, archivage et synchronisation automatique de dossiers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/documind-agent"
    ]
  }
}
