# DocuMind environment — copy to .env and adjust.
# Default setup: fully local OCR + LLM, no paid API key.

# Data directory (originals, SQLite DB, model cache, OCR cache, bench)
DOCUMIND_DATA_DIR=/opt/documind-data

# Local LLM (MiniCPM5-2B served by llama.cpp, OpenAI-compatible)
AI_PROVIDER=llamacpp
LLAMACPP_BASE_URL=http://192.168.1.59:8080
LLAMACPP_MODEL=minicpm5-2b
# Disable thinking so metadata extraction returns deterministic JSON
LLM_DISABLE_THINKING=1

# Local OCR (OvisOCR3 served by llama.cpp)
OCR_BACKEND=ovis
OVISOCR_URL=http://192.168.1.59:8081/v1
OVISOCR_MODEL=ovisocr3
# 130 DPI = measured speed/quality sweet spot (150 is slower, 100 loses fields)
OCR_DPI=130
OCR_PROMPT=plain
OCR_PAGE_TIMEOUT=400
OCR_PAGE_RETRIES=2
OCR_CACHE_ENABLED=1

# Multi-document scans: split into child records with page ranges
SEGMENT_MULTI_DOC=1

# Long-document map-reduce (characters of OCR text before splitting)
LLM_MAP_CHUNK_CHARS=200000
LLM_MAP_CHUNK_PAGES=8

# Embeddings (local sentence-transformers, lazy loaded)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_LAZY_LOAD=1

# SQLite tuning
SQLITE_CACHE_MB=20
SQLITE_MMAP_MB=128

# Logging
PYTHONUNBUFFERED=1

# Optional NAS/SMB sync (leave empty to disable; do not commit credentials)
NAS_HOST=
NAS_SHARE=
NAS_PATH=
NAS_USERNAME=
NAS_PASSWORD=
DOCUMIND_API_URL=http://localhost:8000

# Legacy providers (not used by default)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
