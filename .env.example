# DocuMind environment — copy to .env and adjust.
# Default setup: fully local OCR + LLM, no cloud API key.
# The local LLM still requires its own LLM_API_KEY (Bearer token).

# Data directory (originals, SQLite DB, model cache, OCR cache, bench)
DOCUMIND_DATA_DIR=/opt/documind-data

# Local LLM: Qwen3.8-27B served by HyperQwen/vLLM (OpenAI-compatible)
# AI_PROVIDER=llamacpp is the legacy id for the local OpenAI-compatible server.
AI_PROVIDER=llamacpp
# Base URL with or without the /v1 suffix (both are accepted).
LLM_BASE_URL=http://192.168.1.59:18020/v1
LLM_MODEL=qwen3.8-27b
# MANDATORY Bearer token. Never commit it; export it in the service env.
LLM_API_KEY=
# Backwards-compatible aliases (still read if LLM_* are unset):
# LLAMACPP_BASE_URL=http://192.168.1.59:18020/v1
# LLAMACPP_MODEL=qwen3.8-27b

# Qwen context is 196608 tokens; keep output <= 16384.
LLM_MAX_TOKENS=16384
LLM_MAX_CONTEXT_TOKENS=196608
# Disable thinking so metadata extraction returns deterministic JSON
LLM_DISABLE_THINKING=1
# Text-only profile: images go to OvisOCR3 only, never to the LLM
LLM_LANGUAGE_MODEL_ONLY=1
# Ask vLLM for JSON output; automatic fallback if unsupported
LLM_JSON_MODE=1
# Local 27B can take longer than the former 2B model
LLM_TIMEOUT=900
LLM_CONNECT_TIMEOUT=15

# Local OCR (OvisOCR3 served by llama.cpp)
OCR_BACKEND=ovis
OVISOCR_URL=http://192.168.1.59:8081/v1
OVISOCR_MODEL=ovisocr3
# 130 DPI = measured speed/quality sweet spot (150 is slower, 100 loses fields)
OCR_DPI=130
OCR_PROMPT=plain
OCR_PAGE_TIMEOUT=400
OCR_PAGE_RETRIES=2
OCR_CACHE_ENABLED=1

# Multi-document scans: split into child records with page ranges
SEGMENT_MULTI_DOC=1

# Long-document map-reduce (Qwen 196k context: ~600k chars leaves a margin)
LLM_MAP_CHUNK_CHARS=600000
LLM_MAP_CHUNK_PAGES=24
# Multi-document segmentation limits (short snippet per page)
LLM_SEGMENT_MAX_PAGES=200
LLM_SEGMENT_PAGE_CHARS=2500

# Embeddings (local sentence-transformers, lazy loaded)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_LAZY_LOAD=1

# SQLite tuning
SQLITE_CACHE_MB=20
SQLITE_MMAP_MB=128

# Logging
PYTHONUNBUFFERED=1

# Optional NAS/SMB sync (leave empty to disable; do not commit credentials)
NAS_HOST=
NAS_SHARE=
NAS_PATH=
NAS_USERNAME=
NAS_PASSWORD=
DOCUMIND_API_URL=http://localhost:8000

# Legacy providers (not used by default)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=
